# Copy to .env.local (git-ignored) and fill in. Server details must never be committed:
# the repository is public. Read at build time by electron-vite.

# Sentaurus license servers, as SNPSLMD_LICENSE_FILE (port@host, separated by colons).
# Without it, the launchers leave SNPSLMD_LICENSE_FILE to the user's own environment.
MAIN_VITE_SNPSLMD_LICENSE_FILE=
